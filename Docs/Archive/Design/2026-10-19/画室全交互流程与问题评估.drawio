        <mxCell id="issue_1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_1" target="issue_1_cause">
