        <mxCell id="issue_3" value="P0-3｜旁白会抢断且不补播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#7f1d1d;" vertex="1" parent="1">
