        <mxCell id="issue_2_cause" value="湿色、屋顶、油灯、帘布各有局部约束，却没有整体阶段状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
