  <diagram id="diagnosis" name="03 不合理点与优先级">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="2420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_banner" value="流程诊断｜按对首次理解与路线可读性的影响排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#163a5a;fontStyle=1;fontSize=15;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="2220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_1" value="P0-1｜作画像选菜单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_1_cause" value="来源物件先选固定 motif，之后回主视角再点画布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="220" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_1_impact" value="玩家预期拿笔直接画；实际是反复切镜头后播放固定短笔触" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_1_remedy" value="让画布成为主入口；笔／颜料直接参与落笔，实物只作观察参照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="140" height="60" as="geometry" />
