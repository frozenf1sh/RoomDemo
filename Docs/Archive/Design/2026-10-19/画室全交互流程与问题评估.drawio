        <mxCell id="issue_5_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_5_impact" target="issue_5_remedy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_6" value="P1-6｜两个“灯”容易混淆" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#6b4f00;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_6_cause" value="桌上主灯是静物来源；左侧油灯才是点火、前后观察来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="2020" y="1360" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_6_impact" value="画灯与点灯相邻但对象不同；首次探索可能把角色意图理解错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1840" y="1480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_6_remedy" value="在悬停名、近景提示和旁白中持续区分“画面参考灯”与“待点油灯”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="2020" y="1600" width="140" height="60" as="geometry" />
