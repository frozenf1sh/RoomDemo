        <mxCell id="p2_note" value="阅读口径：根交互来自第 1 页。攻略推荐顺序不等于程序前置；除局部动作和下列事实门槛外，玩家可交错操作。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
