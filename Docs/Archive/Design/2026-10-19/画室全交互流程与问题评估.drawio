        <mxCell id="issue_2" value="P0-2｜开局没有阶段门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="940" y="280" width="140" height="60" as="geometry" />
