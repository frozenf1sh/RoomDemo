        <mxCell id="issue_3_cause" value="每次 Say 都 ReplaceAll；请求时就记一次性；延迟句没有完整阶段校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="2020" y="400" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_3_impact" value="后来一句截断当前说明，旧句不会重放；顺序快时提示互相覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1840" y="520" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_3_remedy" value="改成阶段化队列；剧情前进时取消过期延时；只在真正播出后消耗一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="2020" y="640" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_3" target="issue_3_cause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_3_cause" target="issue_3_impact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_3_impact" target="issue_3_remedy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_4" value="P1-4｜现实路线暗中锁定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#6b4f00;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_cause" value="任一成功的现实解释计偏离；交稿要求从未偏离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="220" y="1360" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_impact" value="一次尝试就隐藏“就交这张”；台词批评越界，但没说路线已转向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_remedy" value="首次转向时明确说明可达后果并保留回旋；不必增加路线选择弹窗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="220" y="1600" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_4" target="issue_4_cause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_4_cause" target="issue_4_impact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_4_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_4_impact" target="issue_4_remedy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_5" value="P1-5｜“共同开场”不是实际门槛" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#6b4f00;" vertex="1" parent="1">
          <mxGeometry x="940" y="1240" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_5_cause" value="定稿只查三项画中解释和零偏离；不查 BrushSketched／StillLifePainted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1360" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_5_impact" value="玩家可跳过独立画笔静物，也可能拿不到预期的“东西都在了”旁白" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b00;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="940" y="1480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_5_remedy" value="决定哪些开场事实必须完成，再让规则门槛、叙述和攻略用同一套条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1600" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="issue_5_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_5" target="issue_5_cause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="issue_5_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=1.3;endArrow=classic;endFill=1;fontSize=10;fontColor=#334155;" edge="1" parent="1" source="issue_5_cause" target="issue_5_impact">
          <mxGeometry relative="1" as="geometry" />
